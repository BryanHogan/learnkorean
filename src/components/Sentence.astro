---
import { markdownProcessor } from '../utils/markdown';

interface Props {
  ko: string;
  en: string;
}

// In MDX: <Sentence ko="비가 오고 **있는데** 우산이 없어요." en="It's raining, but I don't have an umbrella." />
const { ko, en } = Astro.props;
const markdown = await markdownProcessor;
const [korean, english] = await Promise.all([markdown.render(ko), markdown.render(en)]);
---

<div class="sentence not-content">
  <div class="korean" lang="ko" set:html={korean.code} />
  <div class="english" lang="en" set:html={english.code} />
</div>

<style>
  .sentence {
    margin-block: 1rem;
    padding: 0.875rem 1.125rem;
    border-radius: 0.5rem;
    background-color: var(--sl-color-gray-6);
    line-height: 1.6;
    overflow-wrap: anywhere;
  }

  /* Consecutive examples form one group without additional authoring markup. */
  .sentence:has(+ .sentence) {
    margin-block-end: 0;
    border-end-start-radius: 0;
    border-end-end-radius: 0;
  }

  .sentence + .sentence {
    margin-block-start: 0;
    border-block-start: 1px solid var(--sl-color-gray-5);
    border-start-start-radius: 0;
    border-start-end-radius: 0;
  }

  .korean {
    color: var(--sl-color-white);
    font-size: 1.125rem;
  }

  .english {
    margin-block-start: 0.25rem;
    color: var(--sl-color-gray-2);
    font-size: 1rem;
  }

  .sentence :global(p) { margin: 0; }
  .sentence :global(p + p) { margin-block-start: 0.25rem; }
  .sentence :global(strong) {
    color: var(--sl-color-accent-high);
    font-weight: 700;
  }
  .sentence :global(em) { font-style: italic; }
  .sentence :global(a) {
    color: var(--sl-color-text-accent);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
