---
import { getCollection, type CollectionEntry } from 'astro:content';

const docs = await getCollection('docs');
const docsById = new Map(docs.map((doc) => [doc.id, doc]));
const units = Astro.locals.starlightRoute.sidebar.filter(
	(entry) => entry.type === 'group' && entry.label.startsWith('Unit ')
);
const unitDescriptions: Record<string, string> = {
	'Unit 0':
		'Unit 0 focuses on teaching Hangul, the Korean alphabet. Start here if you are a beginner.',
	'Unit 1': 'Unit 1 teaches you the basics of creating your first Korean sentences.',
};

function getChapter(href: string, sidebarLabel: string): CollectionEntry<'docs'> {
	const pathname = new URL(href, Astro.url).pathname;
	const id = decodeURIComponent(pathname)
		.replace(/^\/+|\/+$/g, '')
		.replace(/\/index$/, '');
	const chapter = docsById.get(id);

	if (!chapter) {
		throw new Error(
			`Could not find a docs collection entry for sidebar chapter "${sidebarLabel}" (${href}).`
		);
	}

	if (!chapter.data.description) {
		throw new Error(`Sidebar chapter "${sidebarLabel}" (${href}) is missing a description.`);
	}

	return chapter;
}
---

<div>
	{
		units.map((unit) => (
			<section>
				<h2>{unit.label}</h2>
				{unitDescriptions[unit.label] && <p>{unitDescriptions[unit.label]}</p>}
				<ol>
					{unit.entries
						.filter((entry) => entry.type === 'link')
						.map((chapterLink) => {
							const chapter = getChapter(chapterLink.href, chapterLink.label);

							return (
								<li>
									<a href={chapterLink.href}>{chapter.data.title}</a>: {chapter.data.description}
								</li>
							);
						})}
				</ol>
			</section>
		))
	}
</div>
